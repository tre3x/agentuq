AZURE_API_KEY=your-azure-api-key-here
AZURE_API_BASE=https://your-resource.openai.azure.com
AZURE_API_VERSION=2024-05-01-preview
ANTHROPIC_API_KEY="your-anthropic-key"
OPENAI_API_KEY="your-openai-key"
OPENAI_API_BASE="http://127.0.0.1:8000/v1"

# Locally hosted, OpenAI-compatible model server (vLLM / llama.cpp / TGI).
# Select it by prefixing the model name with "hosted_vllm/", e.g.
#   --agent-llm hosted_vllm/Qwen3.5-122B-A10B
# VLLM_API_KEY can be any non-empty placeholder when the server has no auth.
# Append _AGENT or _USER to point the agent and user simulator at different
# endpoints (e.g. VLLM_API_BASE_AGENT).
VLLM_API_BASE="http://nova22-gpu-2:8080/v1"
VLLM_API_KEY="dummy"
